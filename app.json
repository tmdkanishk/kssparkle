{
  "expo": {
    "name": "Sparkle|وجه تألقي",
    "slug": "Ksasparkle",
    "icon": "./src/assets/images/sparklelogo.png",
    "version": "1.0.1",
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-community/datetimepicker",
      "@react-native-firebase/messaging",
      "react-native-video",
      [
        "expo-adi-registration",
        {
          "token": "CJAU6QLLCMTMOAAAAAAAAAAAAA"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAU0LmfMrzU4oiUvTn3c2UhFs6y-DPQsFU"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to select your address.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "extraCompilerFlags": [
              "-Wno-error=unused-command-line-argument",
              "-fpermissive"
            ]
          }
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-image"
    ],
    "android": {
      "package": "com.ksasparkle",
      "newArchEnabled": false,
      "buildReactNativeFromSource": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ksasparkle",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "FirebaseAppDelegateProxyEnabled": true
        },
        "NSLocationWhenInUseUsageDescription": "We use your location to help you select your address on the map.",
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can upload your profile picture."
      },
      "appleTeamId": "BUTS4JS55S"
    },
    "extra": {
      "eas": {
        "projectId": "cea0233b-f2cb-4f71-8543-5ef27b24c631"
      }
    }
  }
}
